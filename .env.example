# Server-side secrets and deployment configuration
INTRON_API_KEY=
INTRON_ENDPOINT=https://api.intron.io/v1/transcribe
ALLOWED_ORIGINS=https://your-project.pages.dev
# Use true only when the API is behind an identity-aware proxy.
REQUIRE_PROXY_AUTH=false
# Optional FHIR transaction endpoint for a real EHR commit.
EHR_FHIR_ENDPOINT=
EHR_API_KEY=
# Durable stream metadata. Leave D1 values empty for local SQLite fallback.
EDGE_SQLITE_PATH=edge_sync.sqlite3
CLOUDFLARE_D1_API_URL=
CLOUDFLARE_D1_API_TOKEN=
# Optional clinic identifier forwarded by the browser stream client.
SAHARA_CLINIC_ID=default-clinic
